# Copy to .env for local development. .env is git-ignored.
#
# Every variable the services read is listed here. packages/config validates
# them at startup (P0-04) and the process refuses to boot on a missing or
# invalid value. Values below match deploy/docker-compose.yml and are for
# LOCAL DEVELOPMENT ONLY -- shared environments get their values from the
# secrets manager (docs/DEVOPS/04-SECRETS-MANAGEMENT.md).

# --- Process -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL (compose: localhost:55432) ------------------------------------
DATABASE_URL=postgres://image_delivery:image_delivery_dev@localhost:55432/image_delivery

# --- Redis (compose: localhost:56379) -----------------------------------------
REDIS_URL=redis://localhost:56379

# --- Object storage (compose MinIO: localhost:59000) --------------------------
STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=http://localhost:59000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=image-delivery-dev
STORAGE_S3_ACCESS_KEY_ID=image_delivery
STORAGE_S3_SECRET_ACCESS_KEY=image_delivery_dev
STORAGE_S3_FORCE_PATH_STYLE=true
