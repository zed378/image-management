# Copy to .env for local development. .env is git-ignored.
#
# Every variable the services read is listed here. packages/config validates
# them at startup (P0-04) and the process refuses to boot on a missing or
# invalid value. Values below match deploy/docker-compose.yml and are for
# LOCAL DEVELOPMENT ONLY -- shared environments get their values from the
# secrets manager (docs/DEVOPS/04-SECRETS-MANAGEMENT.md).

# --- Process -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL (compose: localhost:55432) ------------------------------------
DATABASE_URL=postgres://image_delivery:image_delivery_dev@localhost:55432/image_delivery

# --- Redis (compose: localhost:56379) -----------------------------------------
REDIS_URL=redis://localhost:56379

# --- Credentials (api) ---------------------------------------------------------
# HMAC key for API-key hashes (ADR-022). Any value starting "dev-only-" is
# refused in production; generate one with: openssl rand -base64 48
API_KEY_PEPPER=dev-only-api-key-pepper-change-me-in-production

# --- Storage (ADR-021) -------------------------------------------------------
# Default: the local disk. STORAGE_LOCAL_ROOT may also be a mounted network
# filesystem (NFS, SMB, EFS). In production STORAGE_LOCAL_ROOT is required.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/storage

# S3-compatible object storage -- e.g. the compose MinIO at localhost:59000:
# STORAGE_PROVIDER=s3
# STORAGE_S3_ENDPOINT=http://localhost:59000
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=image-delivery-dev
# STORAGE_S3_ACCESS_KEY_ID=image_delivery
# STORAGE_S3_SECRET_ACCESS_KEY=image_delivery_dev
# STORAGE_S3_FORCE_PATH_STYLE=true

# Azure Blob Storage:
# STORAGE_PROVIDER=azure-blob
# STORAGE_AZURE_ACCOUNT_NAME=
# STORAGE_AZURE_ACCOUNT_KEY=
# STORAGE_AZURE_CONTAINER=
# STORAGE_AZURE_ENDPOINT=

# SFTP:
# STORAGE_PROVIDER=sftp
# STORAGE_SFTP_HOST=
# STORAGE_SFTP_PORT=22
# STORAGE_SFTP_USERNAME=
# STORAGE_SFTP_PASSWORD=
# STORAGE_SFTP_PRIVATE_KEY=
# STORAGE_SFTP_ROOT=/
# STORAGE_SFTP_HOST_KEY_SHA256=

# WebDAV:
# STORAGE_PROVIDER=webdav
# STORAGE_WEBDAV_URL=
# STORAGE_WEBDAV_USERNAME=
# STORAGE_WEBDAV_PASSWORD=
# STORAGE_WEBDAV_ROOT=/
