{
  "name": "image-delivery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build && node scripts/check-bundle-deps.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "deps:check": "node scripts/deps-check.mjs",
    "dev": "turbo run dev --parallel",
    "infra:up": "docker compose -f deploy/docker-compose.yml up -d --wait postgres redis minio && docker compose -f deploy/docker-compose.yml run --rm minio-init",
    "infra:down": "docker compose -f deploy/docker-compose.yml down",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test:unit && pnpm build",
    "db:migrate": "tsx services/api/src/migrate.ts",
    "audit:deps": "pnpm audit --audit-level=high",
    "scan:secrets": "docker run --rm -v \"$PWD:/repo\" zricethezav/gitleaks:v8.28.0 git /repo --no-banner --redact --config /repo/.gitleaks.toml",
    "prepare": "simple-git-hooks",
    "provision": "tsx services/api/src/provision.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "node scripts/commit-msg.mjs \"$1\"",
    "pre-push": "pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,mts}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{js,mjs,cjs,json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
